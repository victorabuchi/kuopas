# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Suomi.fi e-Identification (OIDC). Leave unset until Kuopas has a real
# registered Suomi.fi e-Identification service (via DVV/Suomi.fi Palveluhallinta) -
# the "Log in with Suomi.fi" button stays disabled without these.
# SUOMIFI_CLIENT_ID=""
# SUOMIFI_CLIENT_SECRET=""
# SUOMIFI_ISSUER_URL=""
# SUOMIFI_REDIRECT_URI="http://localhost:3000/api/auth/suomifi/callback"
