// use prisma-8

enum group_scope {
  @@type("pg/text@1")
  building  = "building"
  stairwell = "stairwell"
  floor     = "floor"
  unit      = "unit"
}

enum building_post_type {
  @@type("pg/text@1")
  announcement = "announcement"
  noticeboard  = "noticeboard"
}

enum noticeboard_category {
  @@type("pg/text@1")
  furniture  = "furniture"
  lost_found = "lost_found"
  borrow     = "borrow"
  giveaway   = "giveaway"
  other      = "other"
}

enum complaint_category {
  @@type("pg/text@1")
  plumbing   = "plumbing"
  electrical = "electrical"
  heating    = "heating"
  appliance  = "appliance"
  pest       = "pest"
  noise      = "noise"
  structural = "structural"
  other      = "other"
}

enum complaint_status {
  @@type("pg/text@1")
  new         = "new"
  in_progress = "in_progress"
  resolved    = "resolved"
}

enum news_category {
  @@type("pg/text@1")
  news       = "news"
  updates    = "updates"
  promotions = "promotions"
  discounts  = "discounts"
  events     = "events"
}

enum tenant_role {
  @@type("pg/text@1")
  resident = "resident"
  admin    = "admin"
}

enum report_status {
  @@type("pg/text@1")
  open      = "open"
  dismissed = "dismissed"
  actioned  = "actioned"
}

model NewsPost {
  id          Uuid              @id @default(uuid())
  title       String
  summary     String
  sourceUrl   String
  category    news_category     @default(news)
  publishedAt TimestamptzString

  @@map("news_post")
}

model Building {
  id              Uuid             @id @default(uuid())
  name            String
  address         String
  stairwells      Stairwell[]
  chatGroup       ChatGroup?
  laundryMachines LaundryMachine[]
  saunaSlots      SaunaSlot[]
  parkingSpots    ParkingSpot[]
  posts           BuildingPost[]
  amenities       BuildingAmenity[]
  spaces          BookableSpace[]

  @@map("building")
}

model SaunaSlot {
  id         Uuid           @id @default(uuid())
  building   Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId Uuid
  label      String
  capacity   Int            @default(6)
  bookings   SaunaBooking[]

  @@unique([buildingId, label])
  @@map("sauna_slot")
}

model SaunaBooking {
  id        Uuid              @id @default(uuid())
  slot      SaunaSlot         @relation(fields: [slotId], references: [id], onDelete: Cascade)
  slotId    Uuid
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  Uuid
  startsAt  TimestamptzString
  endsAt    TimestamptzString
  reminderSentAt TimestamptzString?
  seriesId       Uuid?

  @@unique([slotId, startsAt])
  @@index([tenantId])
  @@map("sauna_booking")
}

model ParkingSpot {
  id         Uuid     @id @default(uuid())
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId Uuid
  label      String
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantId   Uuid?    @unique

  @@unique([buildingId, label])
  @@map("parking_spot")
}

model LaundryMachine {
  id         Uuid             @id @default(uuid())
  building   Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId Uuid
  label      String
  bookings   LaundryBooking[]

  @@unique([buildingId, label])
  @@map("laundry_machine")
}

model LaundryBooking {
  id        Uuid              @id @default(uuid())
  machine   LaundryMachine    @relation(fields: [machineId], references: [id], onDelete: Cascade)
  machineId Uuid
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  Uuid
  startsAt  TimestamptzString
  endsAt    TimestamptzString
  reminderSentAt TimestamptzString?
  seriesId       Uuid?

  @@unique([machineId, startsAt])
  @@index([tenantId])
  @@map("laundry_booking")
}

model Stairwell {
  id          Uuid         @id @default(uuid())
  building    Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId  Uuid
  label       String
  units       Unit[]
  floorGroups FloorGroup[]
  chatGroup   ChatGroup?

  @@unique([buildingId, label])
  @@map("stairwell")
}

model Unit {
  id          Uuid       @id @default(uuid())
  stairwell   Stairwell  @relation(fields: [stairwellId], references: [id], onDelete: Cascade)
  stairwellId Uuid
  code        String
  floor       Int
  tenants     Tenant[]
  chatGroup   ChatGroup?
  bills       SharedBill[]
  chores      Chore[]
  listings    Listing[]
  leases      Lease[]
  media       UnitMedia[]
  amenities   UnitAmenity[]
  kind                String             @default("unspecified")
  roomCount           Int                @default(1)
  furnished           Boolean            @default(false)
  temporary           Boolean            @default(false)
  openForApplications Boolean            @default(false)
  availableFrom       TimestamptzString?
  podApplications     PodApplication[]
  exchangeAllocations ExchangeApplication[]
  inspections         Inspection[]
  agreements          RoommateAgreement[]
  cleaningItems       CleaningItem[]

  @@unique([stairwellId, code])
  @@map("unit")
}

model FloorGroup {
  id          Uuid       @id @default(uuid())
  stairwell   Stairwell  @relation(fields: [stairwellId], references: [id], onDelete: Cascade)
  stairwellId Uuid
  floor       Int
  chatGroup   ChatGroup?

  @@unique([stairwellId, floor])
  @@map("floor_group")
}

model Tenant {
  id                      Uuid              @id @default(uuid())
  name                    String
  pseudonym               String?           @unique
  email                   String            @unique
  passwordHash            String?
  suomiFiPersonId         String?           @unique
  role                    tenant_role       @default(resident)
  staffAccount            Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffId                 Uuid?             @unique
  blockedFromNoticeboard  Boolean           @default(false)
  hasSeenMoveInGuide      Boolean           @default(false)
  unit                    Unit?             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId                  Uuid?
  memberships             ChatGroupMember[]
  messages                Message[]
  laundryBookings         LaundryBooking[]
  saunaBookings           SaunaBooking[]
  parkingSpot             ParkingSpot?
  directConvosA           DirectConversation[] @relation("direct_conversations_as_a")
  directConvosB           DirectConversation[] @relation("direct_conversations_as_b")
  directMessages          DirectMessage[]      @relation("direct_messages_sent")
  buildingPosts           BuildingPost[]
  postComments            BuildingPostComment[]
  postReactions           BuildingPostReaction[]
  postReads               BuildingPostRead[]
  postReports             BuildingPostReport[]
  complaints              Complaint[]
  complaintMessages       ComplaintMessage[]
  noticeThread            DirectNoticeThread?
  noticeMessages          DirectNoticeMessage[]
  pushSubscriptions       PushSubscription[]
  moveInChecklistItems    MoveInChecklistItem[]
  communitiesCreated      Community[]
  communityMemberships    CommunityMember[]
  communityMessages       CommunityMessage[]
  identityVerifications   IdentityVerification[]
  emailVerificationCodes  EmailVerificationCode[]
  matchProfile            MatchProfile?
  matchesSent             MatchConnection[]    @relation("match_sent")
  matchesReceived         MatchConnection[]    @relation("match_received")
  billsPaid               SharedBill[]
  billShares              BillShare[]
  choreTasks              ChoreTask[]
  chatMessageReports      ChatMessageReport[]
  listings                Listing[]
  listingRequests         ListingRequest[]
  subleases               Sublease[]
  leases                  Lease[]
  guarantorRequests       GuarantorRequest[]
  wellbeingCases          WellbeingCase[]
  spaceBookings           SpaceBooking[]
  bookingParticipations   BookingParticipant[]
  podsCreated             Pod[]
  podMemberships          PodMember[]
  exchangeApplication     ExchangeApplication?
  inspections             Inspection[]
  agreementsCreated       RoommateAgreement[]
  agreementSignatures     AgreementSignature[]
  cleaningLogs            CleaningLog[]
  transferRequests        TransferRequest[]
  leaseSignatures         LeaseSignature[]
  bankConnections         BankConnection[]

  @@map("tenant")
}

model Staff {
  id                 Uuid                @id @default(uuid())
  name               String
  email              String              @unique
  passwordHash       String
  createdAt          TimestamptzString   @default(now())
  linkedTenant       Tenant?
  posts              BuildingPost[]
  assignedComplaints Complaint[]
  complaintMessages  ComplaintMessage[]
  noticeMessages     DirectNoticeMessage[]
  savedReplies       SavedReply[]

  @@map("staff")
}

model ChatGroup {
  id           Uuid              @id @default(uuid())
  name         String
  scope        group_scope
  building     Building?         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId   Uuid?             @unique
  stairwell    Stairwell?        @relation(fields: [stairwellId], references: [id], onDelete: Cascade)
  stairwellId  Uuid?             @unique
  floorGroup   FloorGroup?       @relation(fields: [floorGroupId], references: [id], onDelete: Cascade)
  floorGroupId Uuid?             @unique
  unit         Unit?             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId       Uuid?             @unique
  members      ChatGroupMember[]
  messages     Message[]

  @@map("chat_group")
}

model ChatGroupMember {
  id          Uuid              @id @default(uuid())
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    Uuid
  chatGroup   ChatGroup         @relation(fields: [chatGroupId], references: [id], onDelete: Cascade)
  chatGroupId Uuid
  joinedAt    TimestamptzString @default(now())

  @@unique([tenantId, chatGroupId])
  @@map("chat_group_member")
}

model Message {
  id          Uuid              @id @default(uuid())
  content     String
  sentAt      TimestamptzString @default(now())
  sender      Tenant            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId    Uuid
  chatGroup   ChatGroup         @relation(fields: [chatGroupId], references: [id], onDelete: Cascade)
  chatGroupId Uuid
  removedAt   TimestamptzString?
  reports     ChatMessageReport[]

  @@index([chatGroupId])
  @@map("message")
}

model DirectConversation {
  id        Uuid            @id @default(uuid())
  memberA   Tenant          @relation("direct_conversations_as_a", fields: [memberAId], references: [id], onDelete: Cascade)
  memberAId Uuid
  memberB   Tenant          @relation("direct_conversations_as_b", fields: [memberBId], references: [id], onDelete: Cascade)
  memberBId Uuid
  messages  DirectMessage[]

  @@unique([memberAId, memberBId])
  @@map("direct_conversation")
}

model DirectMessage {
  id             Uuid               @id @default(uuid())
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId Uuid
  sender         Tenant             @relation("direct_messages_sent", fields: [senderId], references: [id], onDelete: Cascade)
  senderId       Uuid
  content        String
  sentAt         TimestamptzString  @default(now())

  @@index([conversationId])
  @@map("direct_message")
}

model BuildingPost {
  id                   Uuid                   @id @default(uuid())
  building             Building               @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId           Uuid
  type                 building_post_type
  noticeboardCategory  noticeboard_category?
  authorTenant         Tenant?                @relation(fields: [authorTenantId], references: [id], onDelete: Cascade)
  authorTenantId       Uuid?
  authorStaff          Staff?                 @relation(fields: [authorStaffId], references: [id], onDelete: Cascade)
  authorStaffId        Uuid?
  title                String
  content              String
  titleEn              String?
  contentEn            String?
  photoUrl             String?
  createdAt            TimestamptzString      @default(now())
  comments             BuildingPostComment[]
  reactions            BuildingPostReaction[]
  reads                BuildingPostRead[]
  reports              BuildingPostReport[]

  @@index([buildingId, createdAt])
  @@map("building_post")
}

model BuildingPostComment {
  id        Uuid              @id @default(uuid())
  post      BuildingPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Uuid
  author    Tenant            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  Uuid
  content   String
  createdAt TimestamptzString @default(now())
  reports   BuildingPostReport[]

  @@index([postId])
  @@map("building_post_comment")
}

model BuildingPostReaction {
  id        Uuid              @id @default(uuid())
  post      BuildingPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Uuid
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  Uuid
  emoji     String            @default("👍")
  createdAt TimestamptzString @default(now())

  @@unique([postId, tenantId])
  @@map("building_post_reaction")
}

model Complaint {
  id             Uuid               @id @default(uuid())
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       Uuid
  category       complaint_category
  description    String
  photoUrl       String?
  videoUrl       String?
  clusterId      Uuid?
  status         complaint_status   @default(new)
  assignedStaff  Staff?             @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedStaffId Uuid?
  createdAt      TimestamptzString  @default(now())
  updatedAt      TimestamptzString  @default(now())
  messages       ComplaintMessage[]

  @@index([tenantId])
  @@index([status])
  @@map("complaint")
}

model ComplaintMessage {
  id              Uuid              @id @default(uuid())
  complaint       Complaint         @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  complaintId     Uuid
  senderTenant    Tenant?           @relation(fields: [senderTenantId], references: [id], onDelete: Cascade)
  senderTenantId  Uuid?
  senderStaff     Staff?            @relation(fields: [senderStaffId], references: [id], onDelete: Cascade)
  senderStaffId   Uuid?
  content         String
  sentAt          TimestamptzString @default(now())

  @@index([complaintId])
  @@map("complaint_message")
}

model DirectNoticeThread {
  id       Uuid                  @id @default(uuid())
  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId Uuid                  @unique
  messages DirectNoticeMessage[]

  @@map("direct_notice_thread")
}

model DirectNoticeMessage {
  id             Uuid                @id @default(uuid())
  thread         DirectNoticeThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId       Uuid
  senderStaff    Staff?              @relation(fields: [senderStaffId], references: [id], onDelete: Cascade)
  senderStaffId  Uuid?
  senderTenant   Tenant?             @relation(fields: [senderTenantId], references: [id], onDelete: Cascade)
  senderTenantId Uuid?
  content        String
  sentAt         TimestamptzString   @default(now())

  @@index([threadId])
  @@map("direct_notice_message")
}

model PushSubscription {
  id        Uuid              @id @default(uuid())
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  Uuid
  endpoint  String            @unique
  p256dh    String
  auth      String
  createdAt TimestamptzString @default(now())

  @@index([tenantId])
  @@map("push_subscription")
}

model BuildingPostRead {
  id       Uuid              @id @default(uuid())
  post     BuildingPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId   Uuid
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId Uuid
  readAt   TimestamptzString @default(now())

  @@unique([postId, tenantId])
  @@map("building_post_read")
}

model BuildingPostReport {
  id        Uuid              @id @default(uuid())
  post      BuildingPost?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Uuid?
  comment   BuildingPostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId Uuid?
  reporter  Tenant            @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId Uuid
  reason    String?
  status    report_status     @default(open)
  createdAt TimestamptzString @default(now())

  @@index([postId])
  @@index([commentId])
  @@index([status])
  @@map("building_post_report")
}

model MoveInChecklistItem {
  id          Uuid              @id @default(uuid())
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    Uuid
  itemKey     String
  completedAt TimestamptzString @default(now())

  @@unique([tenantId, itemKey])
  @@map("move_in_checklist_item")
}

model SavedReply {
  id               Uuid              @id @default(uuid())
  title            String
  content          String
  createdByStaff   Staff?            @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)
  createdByStaffId Uuid?
  createdAt        TimestamptzString @default(now())

  @@map("saved_reply")
}

model Community {
  id          Uuid               @id @default(uuid())
  name        String
  description String
  createdBy   Tenant             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById Uuid
  createdAt   TimestamptzString  @default(now())
  members     CommunityMember[]
  messages    CommunityMessage[]

  @@map("community")
}

model CommunityMember {
  id          Uuid              @id @default(uuid())
  community   Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId Uuid
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    Uuid
  joinedAt    TimestamptzString @default(now())

  @@unique([communityId, tenantId])
  @@map("community_member")
}

model CommunityMessage {
  id          Uuid              @id @default(uuid())
  content     String
  sentAt      TimestamptzString @default(now())
  community   Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId Uuid
  sender      Tenant            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId    Uuid

  @@index([communityId])
  @@map("community_message")
}

model VerifiedDomain {
  id          Uuid   @id @default(uuid())
  domain      String @unique
  institution String

  @@map("verified_domain")
}

model IdentityVerification {
  id           Uuid               @id @default(uuid())
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     Uuid
  method       String
  status       String
  institution  String?
  detail       String?
  docPath      String?
  reviewNote   String?
  reviewedById Uuid?
  createdAt    TimestamptzString  @default(now())
  decidedAt    TimestamptzString?

  @@index([tenantId])
  @@index([status])
  @@map("identity_verification")
}

model EmailVerificationCode {
  id        Uuid              @id @default(uuid())
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  Uuid
  email     String
  codeHash  String
  expiresAt TimestamptzString
  attempts  Int               @default(0)
  createdAt TimestamptzString @default(now())

  @@index([tenantId])
  @@map("email_verification_code")
}

model MatchProfile {
  id             Uuid              @id @default(uuid())
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       Uuid              @unique
  active         Boolean           @default(true)
  sleepSchedule  String
  cleanliness    Int
  noiseTolerance Int
  studyHabit     String
  guestPolicy    String
  smoking        String
  alcohol        String
  cooking        String
  bio            String
  dealbreakers   String
  updatedAt      TimestamptzString @default(now())

  @@map("match_profile")
}

model MatchConnection {
  id        Uuid              @id @default(uuid())
  from      Tenant            @relation("match_sent", fields: [fromId], references: [id], onDelete: Cascade)
  fromId    Uuid
  to        Tenant            @relation("match_received", fields: [toId], references: [id], onDelete: Cascade)
  toId      Uuid
  status    String            @default("pending")
  createdAt TimestamptzString @default(now())

  @@unique([fromId, toId])
  @@map("match_connection")
}

model SharedBill {
  id         Uuid               @id @default(uuid())
  unit       Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId     Uuid
  title      String
  category   String
  totalCents Int
  paidBy     Tenant             @relation(fields: [paidById], references: [id], onDelete: Cascade)
  paidById   Uuid
  dueDate    TimestamptzString?
  note       String?
  createdAt  TimestamptzString  @default(now())
  shares     BillShare[]
  kind       String             @default("bill")
  ledgerEntryId Uuid?

  @@index([unitId])
  @@map("shared_bill")
}

model BillShare {
  id          Uuid               @id @default(uuid())
  bill        SharedBill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId      Uuid
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    Uuid
  amountCents Int
  paidAt      TimestamptzString?

  @@unique([billId, tenantId])
  @@map("bill_share")
}

model Chore {
  id        Uuid              @id @default(uuid())
  unit      Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId    Uuid
  title     String
  everyDays Int
  active    Boolean           @default(true)
  createdAt TimestamptzString @default(now())
  tasks     ChoreTask[]

  @@index([unitId])
  @@map("chore")
}

model ChoreTask {
  id           Uuid               @id @default(uuid())
  chore        Chore              @relation(fields: [choreId], references: [id], onDelete: Cascade)
  choreId      Uuid
  assignedTo   Tenant             @relation(fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedToId Uuid
  dueDate      TimestamptzString
  doneAt       TimestamptzString?
  remindedAt   TimestamptzString?

  @@index([choreId])
  @@index([dueDate])
  @@map("chore_task")
}

model ChatMessageReport {
  id         Uuid              @id @default(uuid())
  message    Message           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId  Uuid
  reporter   Tenant            @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId Uuid
  reason     String?
  status     report_status     @default(open)
  createdAt  TimestamptzString @default(now())

  @@index([messageId])
  @@map("chat_message_report")
}

model Listing {
  id                Uuid               @id @default(uuid())
  kind              String
  seller            Tenant             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId          Uuid
  unit              Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId            Uuid
  title             String
  description       String
  priceCents        Int?
  availableFrom     TimestamptzString?
  availableTo       TimestamptzString?
  wanted            String?
  status            String             @default("open")
  acceptedRequestId Uuid?
  createdAt         TimestamptzString  @default(now())
  requests          ListingRequest[]
  subleases         Sublease[]

  @@index([status])
  @@map("listing")
}

model ListingRequest {
  id          Uuid              @id @default(uuid())
  listing     Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId   Uuid
  requester   Tenant            @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId Uuid
  message     String
  status      String            @default("pending")
  createdAt   TimestamptzString @default(now())

  @@unique([listingId, requesterId])
  @@map("listing_request")
}

model Sublease {
  id           Uuid              @id @default(uuid())
  listing      Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId    Uuid
  subtenant    Tenant            @relation(fields: [subtenantId], references: [id], onDelete: Cascade)
  subtenantId  Uuid
  startDate    TimestamptzString
  endDate      TimestamptzString
  approvedById Uuid?
  createdAt    TimestamptzString @default(now())

  @@map("sublease")
}

model AcademicTerm {
  id         Uuid              @id @default(uuid())
  name       String
  kind       String
  startDate  TimestamptzString
  endDate    TimestamptzString
  moveInFrom TimestamptzString
  moveInTo   TimestamptzString
  createdAt  TimestamptzString @default(now())

  @@map("academic_term")
}

model Lease {
  id               Uuid              @id @default(uuid())
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId         Uuid
  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId           Uuid
  kind             String
  startDate        TimestamptzString
  endDate          TimestamptzString
  monthlyRentCents Int
  depositCents     Int               @default(0)
  upfrontMonths    Int               @default(0)
  status           String            @default("active")
  termId           Uuid?
  createdAt        TimestamptzString @default(now())
  charges          LeaseCharge[]
  staffSignedAt    TimestamptzString?
  staffSignedById  Uuid?
  signatures       LeaseSignature[]

  @@index([tenantId])
  @@index([unitId])
  @@map("lease")
}

model LeaseCharge {
  id          Uuid               @id @default(uuid())
  lease       Lease              @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  leaseId     Uuid
  periodStart TimestamptzString
  periodEnd   TimestamptzString
  amountCents Int
  prorated    Boolean            @default(false)
  dueDate     TimestamptzString
  paidAt      TimestamptzString?

  @@index([leaseId])
  @@map("lease_charge")
}

model UnitMedia {
  id        Uuid              @id @default(uuid())
  unit      Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId    Uuid
  url       String
  kind      String
  caption   String?
  createdAt TimestamptzString @default(now())

  @@index([unitId])
  @@map("unit_media")
}

model GuarantorInstitution {
  id          Uuid    @id @default(uuid())
  name        String
  description String
  url         String?
  active      Boolean @default(true)
  requests    GuarantorRequest[]

  @@map("guarantor_institution")
}

model GuarantorRequest {
  id             Uuid                  @id @default(uuid())
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       Uuid
  institution    GuarantorInstitution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  institutionId  Uuid?
  kind           String
  guarantorName  String?
  guarantorEmail String?
  guarantorPhone String?
  status         String                @default("pending")
  staffNote      String?
  createdAt      TimestamptzString     @default(now())
  decidedAt      TimestamptzString?

  @@index([tenantId])
  @@map("guarantor_request")
}

model WellbeingCase {
  id             Uuid               @id @default(uuid())
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       Uuid
  category       String
  severity       String
  description    String
  consentToShare Boolean
  status         String             @default("open")
  origin         String             @default("self")
  escalatedTo    String?
  escalatedAt    TimestamptzString?
  createdAt      TimestamptzString  @default(now())
  events         WellbeingEvent[]

  @@index([tenantId])
  @@index([status])
  @@map("wellbeing_case")
}

model WellbeingEvent {
  id        Uuid              @id @default(uuid())
  caseRef   WellbeingCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    Uuid
  actor     String
  action    String
  detail    String?
  createdAt TimestamptzString @default(now())

  @@index([caseId])
  @@map("wellbeing_event")
}

model BuildingAmenity {
  id         Uuid     @id @default(uuid())
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId Uuid
  kind       String
  enabled    Boolean

  @@unique([buildingId, kind])
  @@map("building_amenity")
}

model UnitAmenity {
  id      Uuid    @id @default(uuid())
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId  Uuid
  kind    String
  enabled Boolean

  @@unique([unitId, kind])
  @@map("unit_amenity")
}

model BookableSpace {
  id                 Uuid              @id @default(uuid())
  building           Building          @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId         Uuid
  kind               String
  name               String
  description        String?
  capacity           Int               @default(6)
  openHour           Int               @default(8)
  closeHour          Int               @default(22)
  maxHoursPerBooking Int               @default(2)
  maxHoursPerWeek    Int               @default(4)
  advanceDays        Int               @default(14)
  createdAt          TimestamptzString @default(now())
  bookings           SpaceBooking[]

  @@unique([buildingId, name])
  @@map("bookable_space")
}

model SpaceBooking {
  id        Uuid              @id @default(uuid())
  space     BookableSpace     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId   Uuid
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  Uuid
  startsAt  TimestamptzString
  endsAt    TimestamptzString
  note      String?
  createdAt TimestamptzString @default(now())
  reminderSentAt TimestamptzString?
  seriesId       Uuid?

  @@index([spaceId, startsAt])
  @@index([tenantId])
  @@map("space_booking")
}

model BookingParticipant {
  id        Uuid              @id @default(uuid())
  kind      String
  bookingId Uuid
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  Uuid
  status    String            @default("invited")
  createdAt TimestamptzString @default(now())

  @@unique([kind, bookingId, tenantId])
  @@index([tenantId])
  @@map("booking_participant")
}

model Pod {
  id         Uuid              @id @default(uuid())
  name       String
  creator    Tenant            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId  Uuid
  status     String            @default("forming")
  minScore   Int               @default(60)
  note       String?
  createdAt  TimestamptzString @default(now())
  members    PodMember[]
  applications PodApplication[]

  @@index([creatorId])
  @@map("pod")
}

model PodMember {
  id          Uuid              @id @default(uuid())
  pod         Pod               @relation(fields: [podId], references: [id], onDelete: Cascade)
  podId       Uuid
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    Uuid
  status      String            @default("invited")
  invitedById Uuid?
  createdAt   TimestamptzString @default(now())

  @@unique([podId, tenantId])
  @@index([tenantId])
  @@map("pod_member")
}

model PodApplication {
  id          Uuid               @id @default(uuid())
  pod         Pod                @relation(fields: [podId], references: [id], onDelete: Cascade)
  podId       Uuid
  unit        Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId      Uuid
  status      String             @default("submitted")
  message     String?
  staffNote   String?
  decidedById Uuid?
  createdAt   TimestamptzString  @default(now())
  decidedAt   TimestamptzString?

  @@unique([podId, unitId])
  @@index([unitId])
  @@map("pod_application")
}

model ExchangeApplication {
  id             Uuid               @id @default(uuid())
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       Uuid               @unique
  homeUniversity String
  homeCountry    String?
  arrival        TimestamptzString
  departure      TimestamptzString
  prefer         String             @default("any")
  message        String?
  docPath        String?
  status         String             @default("submitted")
  staffNote      String?
  allocatedUnit  Unit?              @relation(fields: [allocatedUnitId], references: [id], onDelete: SetNull)
  allocatedUnitId Uuid?
  leaseId        Uuid?
  createdAt      TimestamptzString  @default(now())
  decidedAt      TimestamptzString?

  @@index([status])
  @@map("exchange_application")
}

model Inspection {
  id               Uuid               @id @default(uuid())
  unit             Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId           Uuid
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId         Uuid
  kind             String
  status           String             @default("draft")
  dueAt            TimestamptzString?
  submittedAt      TimestamptzString?
  contentHash      String?
  acknowledgedById Uuid?
  acknowledgedAt   TimestamptzString?
  staffNote        String?
  createdAt        TimestamptzString  @default(now())
  items            InspectionItem[]

  @@index([tenantId])
  @@index([unitId])
  @@map("inspection")
}

model InspectionItem {
  id           Uuid              @id @default(uuid())
  inspection   Inspection        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId Uuid
  area         String
  item         String
  condition    String            @default("unset")
  note         String?
  photoUrl     String?
  createdAt    TimestamptzString @default(now())

  @@index([inspectionId])
  @@map("inspection_item")
}

model RoommateAgreement {
  id          Uuid                 @id @default(uuid())
  unit        Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId      Uuid
  version     Int
  status      String               @default("draft")
  clauses     String
  createdBy   Tenant               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById Uuid
  createdAt   TimestamptzString    @default(now())
  activatedAt TimestamptzString?
  signatures  AgreementSignature[]

  @@index([unitId])
  @@map("roommate_agreement")
}

model AgreementSignature {
  id          Uuid              @id @default(uuid())
  agreement   RoommateAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  agreementId Uuid
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    Uuid
  signedAt    TimestamptzString @default(now())

  @@unique([agreementId, tenantId])
  @@map("agreement_signature")
}

model CleaningItem {
  id        Uuid              @id @default(uuid())
  unit      Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId    Uuid
  area      String
  label     String
  active    Boolean           @default(true)
  createdAt TimestamptzString @default(now())
  logs      CleaningLog[]

  @@index([unitId])
  @@map("cleaning_item")
}

model CleaningLog {
  id        Uuid              @id @default(uuid())
  item      CleaningItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    Uuid
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  Uuid
  weekStart TimestamptzString
  doneAt    TimestamptzString @default(now())

  @@unique([itemId, weekStart])
  @@map("cleaning_log")
}

model TransferRequest {
  id             Uuid               @id @default(uuid())
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       Uuid
  fromUnitId     Uuid?
  wants          String
  reason         String
  description    String
  triedAgreement Boolean            @default(false)
  checklistRate  Int                @default(0)
  status         String             @default("open")
  staffNote      String?
  decidedById    Uuid?
  createdAt      TimestamptzString  @default(now())
  decidedAt      TimestamptzString?

  @@index([tenantId])
  @@index([status])
  @@map("transfer_request")
}

model LeaseSignature {
  id           Uuid              @id @default(uuid())
  lease        Lease             @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  leaseId      Uuid
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     Uuid
  method       String
  personHash   String
  documentHash String
  signedAt     TimestamptzString @default(now())

  @@unique([leaseId, tenantId])
  @@map("lease_signature")
}

model BankConnection {
  id              Uuid               @id @default(uuid())
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId        Uuid
  provider        String
  status          String             @default("active")
  sessionRef      String
  accountRef      String
  accountLabel    String
  consentExpiresAt TimestamptzString?
  lastSyncAt      TimestamptzString?
  createdAt       TimestamptzString  @default(now())
  entries         LedgerEntry[]

  @@index([tenantId])
  @@map("bank_connection")
}

model LedgerEntry {
  id           Uuid              @id @default(uuid())
  connection   BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId Uuid
  externalId   String
  bookedAt     TimestamptzString
  amountCents  Int
  currency     String            @default("EUR")
  counterparty String
  description  String?
  status       String            @default("new")
  billId       Uuid?
  createdAt    TimestamptzString @default(now())

  @@unique([connectionId, externalId])
  @@map("ledger_entry")
}

model AppSetting {
  key   String @id
  value String

  @@map("app_setting")
}
